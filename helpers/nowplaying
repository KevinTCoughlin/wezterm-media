#!/bin/bash
# SPDX-License-Identifier: MIT
# Runs the Swift helper in a MediaRemote-compatible mode.

set -euo pipefail

if [[ "$(uname -s)" != "Darwin" ]]; then
    exit 0
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly SCRIPT_DIR
readonly SOURCE="$SCRIPT_DIR/nowplaying.swift"

macos_major="$(sw_vers -productVersion | cut -d. -f1)"
if [[ ! "$macos_major" =~ ^[0-9]+$ ]]; then
    echo "nowplaying: unable to determine macOS version" >&2
    exit 1
fi

# macOS 26 restricts unsigned compiled clients from reading MediaRemote.
if (( macos_major >= 26 )); then
    exec xcrun swift "$SOURCE"
fi

if [[ -z "${HOME:-}" ]]; then
    echo "nowplaying: HOME is not set" >&2
    exit 1
fi

readonly CACHE_ROOT="${XDG_CACHE_HOME:-$HOME/Library/Caches}/wezterm-media"
readonly BINARY="$CACHE_ROOT/nowplaying"

umask 077
mkdir -p "$CACHE_ROOT"
chmod 700 "$CACHE_ROOT"

if [[ ! -x "$BINARY" || "$SOURCE" -nt "$BINARY" ]]; then
    candidate="$CACHE_ROOT/nowplaying.$$"
    trap 'rm -f "$candidate"' EXIT
    xcrun swiftc -O "$SOURCE" -o "$candidate"
    mv -f "$candidate" "$BINARY"
    trap - EXIT
fi

exec "$BINARY"
